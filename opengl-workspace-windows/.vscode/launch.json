{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Active OpenGL File",
      "type": "cppdbg",
      "request": "launch",
      "program": "${fileDirname}\\${fileBasenameNoExtension}.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${fileDirname}",
      "environment": [
        {"name": "PATH", "value": "${workspaceFolder}\\toolchain\\ucrt64\\bin;${env:PATH}"}
      ],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "${workspaceFolder}\\toolchain\\ucrt64\\bin\\gdb.exe",
      "preLaunchTask": "Build Active OpenGL File",
      "setupCommands": [
        {"description": "Enable GDB pretty-printing", "text": "-enable-pretty-printing", "ignoreFailures": true}
      ]
    }
  ]
}
