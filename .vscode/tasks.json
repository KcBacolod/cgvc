{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Active OpenGL File",
      "type": "process",
      "command": "${workspaceFolder}\\opengl-workspace-windows\\toolchain\\ucrt64\\bin\\g++.exe",
      "args": [
        "-std=c++17",
        "-Wall",
        "-Wextra",
        "-g",
        "${file}",
        "-o",
        "${fileDirname}\\${fileBasenameNoExtension}.exe",
        "-lfreeglut",
        "-lopengl32",
        "-lglu32"
      ],
      "options": {
        "cwd": "${fileDirname}",
        "env": {
          "PATH": "${workspaceFolder}\\opengl-workspace-windows\\toolchain\\ucrt64\\bin;${env:PATH}"
        }
      },
      "problemMatcher": ["$gcc"],
      "group": "build",
      "detail": "Build the active C++ file with the bundled UCRT64 OpenGL toolchain"
    },
    {
      "label": "Build and Run Active OpenGL File",
      "type": "process",
      "command": "${fileDirname}\\${fileBasenameNoExtension}.exe",
      "dependsOn": "Build Active OpenGL File",
      "dependsOrder": "sequence",
      "options": {
        "cwd": "${fileDirname}",
        "env": {
          "PATH": "${workspaceFolder}\\opengl-workspace-windows\\toolchain\\ucrt64\\bin;${env:PATH}"
        }
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "Build and run the active OpenGL program"
    }
  ]
}
